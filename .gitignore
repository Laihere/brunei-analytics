# Raw downloads stay local (see DATA_USE_POLICY.md, SOP rule 3)
data/raw/*
!data/raw/.gitkeep

# Full cleaned tables stay local too (DATA_USE_POLICY.md §4 rule 3); only the README is shared
data/clean/*
!data/clean/README.md

# Local cache used by catalogue/build_catalogue.py
.cache/

# Personal drafts (emails stay private)
email_draft/
email_draft*.txt

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Quarto
dashboard/_site/
dashboard/.quarto/
**/*.quarto_ipynb
