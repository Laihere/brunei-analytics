```{=html}
<% if (items.length === 0) { %>
<div class="link-card soon featured">
  <div class="kicker">Case study 01 · In progress</div>
  <div class="title">The first case study is being written.</div>
</div>
<% } %>
<% for (const [i, item] of items.entries()) { %>
<% if (i === 0) { %>
<a class="link-card featured" href="<%- item.path %>" <%= metadataAttrs(item) %>>
  <div class="kicker"><%= item.number %> · <%= item.topic %></div>
  <div class="title"><%= item.title %></div>
  <p class="desc"><%= item.description %></p>
  <div class="date"><% if (item["data-period"]) { %>Data: <%= item["data-period"] %> · <% } %>Published <%= item.date %><% if (item["read-time"]) { %> · <%= item["read-time"] %><% } %></div>
</a>
<% if (items.length > 1) { %><div class="link-cards latest-more"><% } %>
<% } else { %>
  <a class="link-card" href="<%- item.path %>" <%= metadataAttrs(item) %>>
    <div class="kicker"><%= item.number %> · <%= item.topic %></div>
    <div class="title"><%= item.title %></div>
    <div class="date"><% if (item["data-period"]) { %>Data: <%= item["data-period"] %> · <% } %>Published <%= item.date %></div>
  </a>
<% } %>
<% } %>
<% if (items.length > 1) { %></div><% } %>
```
